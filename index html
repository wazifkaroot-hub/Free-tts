<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Voxify TTS</title>

<style>
*{
  box-sizing:border-box;
}

body{
  margin:0;
  padding:15px;
  font-family:Arial,sans-serif;
  background:#080b14;
  color:white;
}

.app{
  width:100%;
  max-width:800px;
  margin:auto;
}

h1{
  text-align:center;
  color:#00d9ff;
  margin:15px 0 5px;
}

.sub{
  text-align:center;
  color:#8994ad;
  margin-bottom:20px;
}

.box{
  background:#111827;
  padding:18px;
  border-radius:20px;
  border:1px solid #26334d;
}

textarea{
  width:100%;
  height:250px;
  resize:vertical;
  background:#070b13;
  color:white;
  border:1px solid #34415d;
  border-radius:14px;
  padding:15px;
  font-size:17px;
  outline:none;
}

textarea:focus{
  border-color:#00d9ff;
}

select{
  width:100%;
  padding:13px;
  margin-top:8px;
  background:#070b13;
  color:white;
  border:1px solid #34415d;
  border-radius:10px;
}

label{
  display:block;
  margin-top:15px;
  color:#b7c1d8;
}

input[type="range"]{
  width:100%;
  accent-color:#00d9ff;
}

button{
  width:100%;
  padding:14px;
  margin-top:10px;
  border:0;
  border-radius:11px;
  color:white;
  font-weight:bold;
  font-size:15px;
  cursor:pointer;
}

.speak{
  background:#008fc4;
}

.pause{
  background:#45516c;
}

.resume{
  background:#5343a8;
}

.stop{
  background:#a52e49;
}

.clear{
  background:#333d52;
}

#status{
  text-align:center;
  margin-top:15px;
  color:#00d9ff;
  min-height:20px;
}

.count{
  text-align:right;
  color:#6f7c97;
  font-size:12px;
  margin-top:5px;
}

@media(max-width:600px){
  textarea{
    height:220px;
  }
}
</style>
</head>

<body>

<div class="app">

<h1>🎙️ Voxify TTS</h1>

<div class="sub">
Free Browser Text To Speech
</div>

<div class="box">

<textarea id="text" placeholder="Type your text here...

Hello world!
السلام علیکم
नमस्ते
こんにちは"></textarea>

<div class="count">
<span id="count">0</span> characters
</div>

<label>🌍 Language</label>
<select id="language">
<option value="all">All Languages</option>
</select>

<label>🎙️ Voice</label>
<select id="voice">
<option value="">Loading voices...</option>
</select>

<label>
⚡ Speed:
<span id="speedText">1.0</span>
</label>

<input id="speed" type="range"
min="0.3" max="2" step="0.1" value="1">

<label>
🎵 Pitch:
<span id="pitchText">1.0</span>
</label>

<input id="pitch" type="range"
min="0" max="2" step="0.1" value="1">

<label>
🔊 Volume:
<span id="volumeText">100%</span>
</label>

<input id="volume" type="range"
min="0" max="1" step="0.1" value="1">

<button class="speak" onclick="speak()">
▶️ SPEAK
</button>

<button class="pause" onclick="pauseSpeech()">
⏸️ PAUSE
</button>

<button class="resume" onclick="resumeSpeech()">
▶️ RESUME
</button>

<button class="stop" onclick="stopSpeech()">
⏹️ STOP
</button>

<button class="clear" onclick="clearText()">
🗑️ CLEAR
</button>

<div id="status">
Loading...
</div>

</div>
</div>

<script>

var synth = window.speechSynthesis;

var voices = [];

var textBox = document.getElementById("text");
var voiceBox = document.getElementById("voice");
var languageBox = document.getElementById("language");

var speed = document.getElementById("speed");
var pitch = document.getElementById("pitch");
var volume = document.getElementById("volume");

var statusBox = document.getElementById("status");

function loadVoices(){

    voices = synth.getVoices();

    if(voices.length === 0){

        statusBox.innerHTML =
        "⏳ Waiting for browser voices...";

        return;
    }

    voiceBox.innerHTML = "";

    languageBox.innerHTML =
    '<option value="all">🌍 All Languages</option>';

    var languages = [];

    for(var i=0;i<voices.length;i++){

        var v = voices[i];

        var option =
        document.createElement("option");

        option.value = i;

        option.textContent =
        v.name + " — " + v.lang;

        voiceBox.appendChild(option);

        if(languages.indexOf(v.lang) === -1){

            languages.push(v.lang);

        }
    }

    languages.sort();

    for(var j=0;j<languages.length;j++){

        var langOption =
        document.createElement("option");

        langOption.value = languages[j];

        langOption.textContent =
        languages[j];

        languageBox.appendChild(langOption);
    }

    statusBox.innerHTML =
    "✅ " + voices.length + " voices available";
}

function filterVoices(){

    var selected =
    languageBox.value;

    voiceBox.innerHTML = "";

    for(var i=0;i<voices.length;i++){

        if(
          selected === "all" ||
          voices[i].lang === selected
        ){

            var option =
            document.createElement("option");

            option.value = i;

            option.textContent =
            voices[i].name +
            " — " +
            voices[i].lang;

            voiceBox.appendChild(option);
        }
    }
}

function speak(){

    var message =
    textBox.value.trim();

    if(message === ""){

        statusBox.innerHTML =
        "⚠️ Please enter text.";

        return;
    }

    synth.cancel();

    var speech =
    new SpeechSynthesisUtterance(message);

    var index =
    parseInt(voiceBox.value);

    if(
      !isNaN(index) &&
      voices[index]
    ){

        speech.voice =
        voices[index];

        speech.lang =
        voices[index].lang;
    }

    speech.rate =
    parseFloat(speed.value);

    speech.pitch =
    parseFloat(pitch.value);

    speech.volume =
    parseFloat(volume.value);

    speech.onstart = function(){

        statusBox.innerHTML =
        "🔊 Speaking...";
    };

    speech.onend = function(){

        statusBox.innerHTML =
        "✅ Finished";
    };

    speech.onerror = function(){

        statusBox.innerHTML =
        "❌ TTS error. Try another voice.";
    };

    synth.speak(speech);
}

function pauseSpeech(){

    if(synth.speaking){

        synth.pause();

        statusBox.innerHTML =
        "⏸️ Paused";
    }
}

function resumeSpeech(){

    if(synth.paused){

        synth.resume();

        statusBox.innerHTML =
        "▶️ Resumed";
    }
}

function stopSpeech(){

    synth.cancel();

    statusBox.innerHTML =
    "⏹️ Stopped";
}

function clearText(){

    synth.cancel();

    textBox.value = "";

    document.getElementById("count")
    .innerHTML = "0";

    statusBox.innerHTML =
    "🗑️ Cleared";
}

textBox.addEventListener(
"input",
function(){

    document.getElementById("count")
    .innerHTML =
    textBox.value.length;
});

speed.addEventListener(
"input",
function(){

    document.getElementById("speedText")
    .innerHTML =
    speed.value;
});

pitch.addEventListener(
"input",
function(){

    document.getElementById("pitchText")
    .innerHTML =
    pitch.value;
});

volume.addEventListener(
"input",
function(){

    document.getElementById("volumeText")
    .innerHTML =
    Math.round(volume.value * 100) + "%";
});

languageBox.addEventListener(
"change",
filterVoices
);

if("speechSynthesis" in window){

    loadVoices();

    synth.onvoiceschanged =
    loadVoices;

}else{

    statusBox.innerHTML =
    "❌ This browser does not support TTS.";
}

</script>

</body>
</html>
